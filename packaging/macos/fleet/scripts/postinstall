#!/bin/bash
# Installs AgentACL for a fleet: everything root-owned, a link for users'
# shells where /usr/local/bin is root's, and the reporting service started.
set -euo pipefail
R="/Library/Application Support/AgentACL"
P=/Library/LaunchDaemons/ai.agentacl.fleet.plist
chown root:wheel "$R" "$R/bin" "$R/bin/agentacl" "$P"
chmod 755 "$R" "$R/bin" "$R/bin/agentacl"
chmod 644 "$P"
if [[ -f "$R/enroll.json" ]]; then
  chown root:wheel "$R/enroll.json"
  chmod 600 "$R/enroll.json"
fi
# /usr/local/bin belongs to Homebrew on Intel Macs: never write into a
# folder a user owns. Replace only a missing file or a link.
if [[ ! -e /usr/local/bin ]]; then
  install -d -o root -g wheel -m 755 /usr/local/bin
fi
if [[ "$(stat -f %u /usr/local/bin)" == 0 ]] && { [[ ! -e /usr/local/bin/agentacl ]] || [[ -L /usr/local/bin/agentacl ]]; }; then
  ln -sfh "$R/bin/agentacl" /usr/local/bin/agentacl
fi
launchctl bootout system/ai.agentacl.fleet 2>/dev/null || true
launchctl bootstrap system "$P"
exit 0
